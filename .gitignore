# Ignore binary files.
bin/

# Ignore C object files.
*.o

# Ignore Python files.
# Environments
python/.env
python/.venv
python/env/
python/venv/
python/ENV/
python/env.bak/
python/venv.bak/

# Generated by Cargo
# will have compiled files and executables
**/debug/
**/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
**/*.pdb
